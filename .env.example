# Security and Environment Variables
# Never commit sensitive data to version control

# API Configuration
REACT_APP_ENVIRONMENT=production

# Security Headers (for deployment)
# These should be configured in your hosting provider or server
REACT_APP_CSP_ENABLED=true

# Contact form (app/api/contact/route.ts). Without these the form shows "copy email" instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional; defaults to Resend's onboarding sender. Use an address on a verified domain in production.
CONTACT_FROM_EMAIL=
